class Book:
    def __init__(self, title, author, isbn, year, pages):
        if pages <= 0:
            raise ValueError("Число страниц должно быть положительным")

        self._title = title
        self._author = author
        self._isbn = isbn
        self._year = year
        self._pages = pages
        self._is_available = True
        self._last_read_pages = 0

    @property
    def title(self):
        return self._title

    @property
    def author(self):
        return self._author

    @property
    def isbn(self):
        return self._isbn

    @property
    def year(self):
        return self._year

    @property
    def pages(self):
        return self._pages

    @property
    def is_available(self):
        return self._is_available

    @property
    def last_read_pages(self):
        return self._last_read_pages

    def borrow(self):
        if not self._is_available:
            raise ValueError("Книга уже выдана")

        self._is_available = False

    def give_back(self, pages_read):
        if self._is_available:
            raise ValueError("Книга уже находится на полке")

        if not 0 <= pages_read <= self.pages:
            raise ValueError(
                f"Количество прочитанных страниц должно быть от 0 до {self.pages}"
            )

        self._last_read_pages = pages_read
        self._is_available = True

    def __eq__(self, other):
        if not isinstance(other, Book):
            return NotImplemented

        return self.isbn == other.isbn

    def __lt__(self, other):
        if not isinstance(other, Book):
            return NotImplemented

        return self.year < other.year

    def __repr__(self):
        return (
            f"Book({self.title!r}, {self.author!r}, {self.isbn!r}, "
            f"{self.year!r}, {self.pages!r})"
        )
b = Book("1984", "Оруэлл", "123", 1949, 328)

print(b.is_available)
print(b.last_read_pages)

b.borrow()

try:
    b.borrow()
except ValueError as error:
    print(error)

try:
    b.give_back(400)
except ValueError as error:
    print(error)

print(b.is_available)

b.give_back(120)

print(b.last_read_pages)
print(b == Book("1984", "Оруэлл", "123", 1949, 328))
